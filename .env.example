# Contact form delivery. Set one of the two options below.
# Nothing configured means the form refuses submissions and says so, rather
# than pretending to have sent them.

# Option 1, preferred: an n8n webhook. Fan out from there.
CONTACT_WEBHOOK_URL=

# Option 2: Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
